# ==============================================================================
# AI-buddy (Avito Start Hack&Change 2026) — Пример конфигурации без секретов
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ==============================================================================

# --- 1. Настройки сервера (Go 1.27.3 Backend) ---
APP_ENV=development
BACKEND_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 2. Внешний LLM API (OpenRouter — совместим с OpenAI SDK) ---
# Требование слайда 9: указаны сервис, модель, переменная окружения и подключение ключа.
# Если OPENROUTER_API_KEY пустой или сервис недоступен, автоматически включается
# детерминированный Smart Fallback режим для гарантированной проверки всех сценариев жюри.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Таймаут обращения к внешнему LLM (мс), чтобы не блокировать интерфейс
LLM_TIMEOUT_MS=15000

# --- 3. Хранилища данных (PostgreSQL & Redis) ---
# Для быстрого локального запуска и тестов поддерживается STORAGE_MODE=memory (по умолчанию)
# или STORAGE_MODE=postgres при запуске полного стека в Docker Compose.
STORAGE_MODE=memory
POSTGRES_DSN=postgres://aibuddy:aibuddy_secret@postgres:5432/aibuddy?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# --- 4. Feature Flags (Runtime-флаги архитектуры Авито — слайд 10, п. 03) ---
FF_ENABLE_MCP_ACTIONS=true
FF_ENABLE_RBAC_STRICT=true
FF_ENABLE_CLICKSTREAM_ANALYTICS=true
FF_ENABLE_PROACTIVE_CRON_HINTS=true
